APP_NAME=CardioPrenatal
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cardioprenatal
DB_USERNAME=pretriagem
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_STANDBY=true

# Serviços Compose `queue` + `scheduler` usam esta fila (não remova).
# Scheduler: a cada 15 min sync --only-new; nos minutos 5/20/35/50 reprocess --only-missing.

# Microsserviço ML (FastAPI) — NÃO usar porta 8000 (Laravel/nginx)
# Compose interno: http://ml:8010
# AnalisePython no host: http://host.docker.internal:8010
PYTHON_API_URL=http://ml:8010
PYTHON_API_KEY=
PYTHON_API_TIMEOUT=30
PYTHON_API_RETRIES=2
PYTHON_API_RETRY_SLEEP_MS=200
PYTHON_API_VERIFY_SSL=true

# Legado (opcional)
CCF_API_URL=http://ml:8010
CCF_API_KEY="${PYTHON_API_KEY}"
CCF_API_TIMEOUT=120
CCF_API_VERIFY_SSL=true

# Produção com TLS no proxy:
# APP_URL=https://seu-dominio
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true
# PYTHON_API_URL=https://ml.interno  (ou http://ml:8010 só em rede Docker privada)

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_HTTP_TIMEOUT=25
