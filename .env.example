APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cardioprenatal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail pelo Laravel (SMTP). Sem Mailpit / n8n.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Cardioprenatal"
MAIL_STANDBY=true

# Microsserviço ML (FastAPI) — porta 8010 (Laravel fica na 8000)
# Dev: http://127.0.0.1:8010 | Docker host: http://host.docker.internal:8010 | Prod: https://ml.seu-dominio
PYTHON_API_URL=http://127.0.0.1:8010
# Mesma chave do API_KEY do serviço Python (obrigatória se a API exigir auth)
PYTHON_API_KEY=
PYTHON_API_TIMEOUT=30
PYTHON_API_RETRIES=2
PYTHON_API_RETRY_SLEEP_MS=200
# true em produção com certificado válido; false só para cert autoassinado em staging
PYTHON_API_VERIFY_SSL=true

# Legado GestRisk/CCF (mesma API ML)
CCF_API_URL="${PYTHON_API_URL}"
CCF_API_KEY="${PYTHON_API_KEY}"
CCF_API_TIMEOUT=120
CCF_API_VERIFY_SSL="${PYTHON_API_VERIFY_SSL}"

# HTTPS do app Laravel (produção atrás de proxy TLS)
# APP_URL=https://seu-dominio
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true

# Interpretação clínica (Gemini/Vertex) — Fase 0 usa mock no FastAPI
# true = após CatBoost, enfileira InterpretarGestanteJob → POST /interpretar/gestante
INTERPRETACAO_GEMINI_ENABLED=true
INTERPRETACAO_PROMPT_VERSION=system_v2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WAHA (WhatsApp HTTP API) — envio ao cadastrar gestante
# Docs: https://waha.devlike.pro/docs/how-to/send-messages/
# POST {WAHA_BASE_URL}/api/sendText — JSON: session, chatId, text — header opcional X-Api-Key
WAHA_BASE_URL=http://127.0.0.1:3000
# Legado (se ainda usar): WAHA_API_URL=
WAHA_API_KEY=
# Legado: WAHA_API_TOKEN=
WAHA_SESSION_NAME=default
# Legado: WAHA_SESSION=
# Rede local sem chave no WAHA:
WAHA_NO_API_KEY=true
# Para exigir chave: WAHA_NO_API_KEY=false e preencha WAHA_API_KEY
# WAHA_ENABLED=   (omitir = ativo se WAHA_BASE_URL estiver definido; ou true/false explícito)
WAHA_HTTP_TIMEOUT=20
WAHA_WEBHOOK_SECRET=
# Lembrete automático diário (acompanhamentos com agendado_para = hoje)
WHATSAPP_AUTO_LEMBRETE=false
# Pausa da IA/n8n depois que a equipe responde no chat (minutos)
WHATSAPP_IA_PAUSA_MINUTOS=240

# LLM do atendimento (troque o provider sem reescrever o fluxo)
LLM_PROVIDER=gemini
# Gemini (camada de inteligência). Não commitar a chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_HTTP_TIMEOUT=25
